# minute_slot_valid.hex one day earlier, CRC valid. Same ring index as the valid slot, but outside the
# window newest-1439..newest once the valid slot is newest: stale, reads as a gap. Generated by tools/gen_fixtures.py.
01 bf 57 9c                                                             # off 0  i32 epochMinute = 29317020 (1440 minutes before the valid slot)
3a                                                                      # off 4  u8  samples = 58
3c                                                                      # off 5  u8  expectedSamples = 60
05                                                                      # off 6  u8  gapMask = chunk_unloaded|target_missing (0x05)
05                                                                      # off 7  u8  lastStateCode = 5 (running)
00 00 00 00 02 32 00 03 00 03                                           # off 8  u8x10 stateSamples
01                                                                      # off 18 u8  maintenanceMax = 1
05                                                                      # off 19 u8  flags = recipesCounterReset|serverStartMinute (0x05)
04 9c                                                                   # off 20 u16 serverTicks = 1180
32                                                                      # off 22 u8  euSamples = 50
00                                                                      # off 23 u8  reserved = 0
00 00 00 00 00 00 07 3a                                                 # off 24 i64 euPerTickAvg = 1850
ff ff ff ff ff ff ff c0                                                 # off 32 i64 euPerTickMin = -64
00 00 00 00 00 00 08 55                                                 # off 40 i64 euPerTickMax = 2133
00 00 00 00 00 18 6a 00                                                 # off 48 i64 energyStoredLast = 1600000
00 00 00 0c                                                             # off 56 i32 recipesCompletedDelta = 12
00 00                                                                   # off 60 u16 reserved = 0
5f 24                                                                   # off 62 u16 CRC = 0x5f24
